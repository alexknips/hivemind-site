---
import '../styles/global.css';
const base = import.meta.env.BASE_URL;
const installCmd = 'curl -fsSL https://raw.githubusercontent.com/alexknips/hivemind/master/scripts/install.sh | sh';
const connectCmd = 'claude mcp add hivemind -- hivemind mcp';
---
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>HiveMind — memory for decisions</title>
  <meta name="description" content="HiveMind is memory for decisions. Your coding agents record what was decided, which options lost and why, and who decided, you or the agent. Local-first, AGPL-3.0, free to self-host." />
  <link rel="icon" type="image/svg+xml" href={`${base}favicon.svg`} />
</head>
<body class="bg-background text-foreground antialiased">

  <!-- Nav: wraps instead of overflowing; the text links drop out below sm -->
  <header class="site-header sticky top-0 z-50 border-b border-border">
    <nav class="max-w-6xl mx-auto px-4 sm:px-6 min-h-16 py-3 flex flex-wrap items-center justify-between gap-x-6 gap-y-2">
      <!-- The app's wordmark: the "blocks" mark in the link colour, then the name (App.tsx). -->
      <a href={base} class="flex items-center gap-2 text-md font-semibold tracking-tight text-foreground">
        <svg class="size-5 text-link" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <rect width="7" height="7" x="14" y="3" rx="1"/>
          <path d="M10 21V8a1 1 0 0 0-1-1H4a1 1 0 0 0-1 1v12a1 1 0 0 0 1 1h12a1 1 0 0 0 1-1v-5a1 1 0 0 0-1-1H3"/>
        </svg>
        HiveMind
      </a>
      <div class="flex flex-wrap items-center gap-x-5 gap-y-2">
        <a href={`${base}getting-started/quickstart/`} class="hidden sm:inline text-sm text-muted-foreground hover:text-foreground transition-colors">Docs</a>
        <a href={`${base}demo/`} class="hidden sm:inline text-sm text-muted-foreground hover:text-foreground transition-colors">Demo</a>
        <a href="https://github.com/alexknips/hivemind" class="text-sm text-muted-foreground hover:text-foreground transition-colors">GitHub</a>
        <a href="#self-host" class="btn btn-primary">Self-host &rarr;</a>
      </div>
    </nav>
  </header>

  <main>

    <!-- Hero: the positioning paragraph (vision/README.md, merged 2026-09-22), verbatim -->
    <section class="max-w-4xl mx-auto px-4 sm:px-6 pt-16 sm:pt-24 pb-16 sm:pb-20 text-center">
      <p class="badge badge-outline mb-8">
        <span class="size-1.5 rounded-full bg-success" aria-hidden="true"></span>
        v0.7.0 &middot; open source &middot; local-first
      </p>
      <h1 class="text-2xl sm:text-3xl font-semibold tracking-tight text-foreground mb-6">
        HiveMind is memory<br class="hidden sm:inline" /> <span class="text-muted-foreground">for decisions.</span>
      </h1>
      <p class="text-md sm:text-lg text-foreground max-w-2xl mx-auto mb-5 leading-relaxed">
        Your coding agents record what was decided, which options lost and why, and who decided,
        you or the agent. The next session does not reintroduce what you dropped or rewrite what
        you agreed. When a decision is contested or replaced, its status changes; nothing goes
        quietly stale.
      </p>
      <p class="text-md text-muted-foreground max-w-2xl mx-auto mb-10">
        One engineer and their agents, local-first, AGPL-3.0, free to self-host.
      </p>

      <div class="flex flex-col sm:flex-row gap-3 justify-center mb-4">
        <a href="#self-host" class="btn btn-primary btn-lg">
          Self-host it &rarr;
        </a>
        <a href={`${base}demo/`} class="btn btn-outline btn-lg">
          Explore a real decision &rarr;
        </a>
      </div>
      <p class="text-sm text-muted-foreground">The demo is the jury room of <em>12 Angry Men</em> as a decision graph. No signup, no install.</p>
    </section>

    <!-- Self-host: the first step -->
    <section id="self-host" class="border-t border-border bg-sidebar scroll-mt-20">
      <div class="max-w-3xl mx-auto px-4 sm:px-6 py-16 sm:py-20">
        <h2 class="text-xl font-semibold tracking-tight text-foreground text-center mb-3">Start on your own machine</h2>
        <p class="text-md text-muted-foreground text-center max-w-xl mx-auto mb-12">
          One binary and a local ledger in your project. No account, no API key, and nothing phones home.
        </p>

        <ol class="border-y border-border divide-y divide-border">
          <li class="py-6 sm:py-7 flex gap-4 min-w-0">
            <span class="w-5 shrink-0 pt-1 text-xs font-mono text-muted-foreground">1</span>
            <div class="min-w-0 flex-1">
              <h3 class="text-md font-semibold text-foreground mb-3">Install HiveMind</h3>
              <pre class="code-block mb-3"><code>{installCmd}</code></pre>
              <p class="text-base text-muted-foreground leading-relaxed">
                Linux (x86_64, ARM64) and Apple Silicon Macs. The script checks the release&rsquo;s SHA-256
                and puts <code class="code">hivemind</code> in <code class="code">~/.local/bin</code>.
                If the next command says <code class="code">hivemind: not found</code>, run
                <code class="code">export PATH="$HOME/.local/bin:$PATH"</code> first.
                Elsewhere, <a href="https://github.com/alexknips/hivemind#install" class="link">build it with cargo</a>.
              </p>
            </div>
          </li>
          <li class="py-6 sm:py-7 flex gap-4 min-w-0">
            <span class="w-5 shrink-0 pt-1 text-xs font-mono text-muted-foreground">2</span>
            <div class="min-w-0 flex-1">
              <h3 class="text-md font-semibold text-foreground mb-3">Connect your agent</h3>
              <pre class="code-block mb-3"><code>{connectCmd}</code></pre>
              <p class="text-base text-muted-foreground leading-relaxed">
                Run it in your project for Claude Code. Decisions go to <code class="code">./hivemind/</code>,
                a SQLite ledger you own. Codex, Cursor and Claude Desktop are in
                <a href={`${base}guides/mcp-setup/`} class="link">MCP setup</a>.
              </p>
            </div>
          </li>
          <li class="py-6 sm:py-7 flex gap-4 min-w-0">
            <span class="w-5 shrink-0 pt-1 text-xs font-mono text-muted-foreground">3</span>
            <div class="min-w-0 flex-1">
              <h3 class="text-md font-semibold text-foreground mb-3">Record a decision, then ask why</h3>
              <div class="code-block font-sans text-base space-y-2 mb-3">
                <p><span class="text-muted-foreground">You:</span> Record a decision: we use SQLite for the ledger. We considered Postgres and rejected it as premature.</p>
                <p><span class="text-muted-foreground">Later:</span> Why did we pick SQLite, and what did we rule out?</p>
              </div>
              <p class="text-base text-muted-foreground leading-relaxed">
                Your agent records it with the options and who decided, and answers from the record.
                The <a href={`${base}getting-started/quickstart/`} class="link">quickstart</a>
                walks through it.
              </p>
            </div>
          </li>
        </ol>

        <p class="text-sm text-muted-foreground text-center mt-8">
          Prefer a server to a local file?
          <a href={`${base}getting-started/install/#run-a-cell-with-docker`} class="link">Run a HiveMind cell with Docker Compose</a>.
        </p>
      </div>
    </section>

    <!-- The three failures, in the words people use (vision/README.md) -->
    <section class="max-w-6xl mx-auto px-4 sm:px-6 py-16 sm:py-20">
      <h2 class="text-xl font-semibold tracking-tight text-foreground text-center mb-3">Who decided what, why, and whether it held up</h2>
      <p class="text-md text-muted-foreground text-center max-w-xl mx-auto mb-12 sm:mb-16">
        Coding agents forget. These are the three ways it hurts, and what HiveMind keeps instead.
      </p>
      <div class="grid md:grid-cols-3 gap-8 sm:gap-10">
        <div class="border-t border-border pt-5">
          <h3 class="text-md font-semibold text-foreground mb-2">It undid what you decided</h3>
          <p class="text-base text-muted-foreground leading-relaxed mb-3">
            You dropped the ORM on purpose. A few weeks later the agent helpfully brings it back,
            with confidence.
          </p>
          <p class="text-base text-foreground leading-relaxed">
            HiveMind keeps the options that lost and why they lost, next to the one you chose.
          </p>
        </div>
        <div class="border-t border-border pt-5">
          <h3 class="text-md font-semibold text-foreground mb-2">Nobody knows why</h3>
          <p class="text-base text-muted-foreground leading-relaxed mb-3">
            <code class="code">git blame</code> says who changed a line, not why the agent did it
            that way. The chat was the design meeting, and it is gone.
          </p>
          <p class="text-base text-foreground leading-relaxed">
            HiveMind records the decision with its rationale, its evidence and who made it: you or the agent.
          </p>
        </div>
        <div class="border-t border-border pt-5">
          <h3 class="text-md font-semibold text-foreground mb-2">It forgot what you agreed</h3>
          <p class="text-base text-muted-foreground leading-relaxed mb-3">
            The hand-kept <code class="code">DECISIONS.md</code> goes stale after a reversal, and the
            agent follows the dead entry.
          </p>
          <p class="text-base text-foreground leading-relaxed">
            In HiveMind a replaced decision reads <span class="badge badge-neutral">superseded</span> and a disputed one
            <span class="badge badge-warning">contested</span>. Nobody has to remember to update it.
          </p>
        </div>
      </div>
    </section>

    <!-- The shelf: memory, but for decisions -->
    <section class="border-t border-border bg-sidebar">
      <div class="max-w-4xl mx-auto px-4 sm:px-6 py-16 sm:py-20">
        <h2 class="text-xl font-semibold tracking-tight text-foreground text-center mb-3">Memory, but for decisions</h2>
        <p class="text-md text-muted-foreground text-center max-w-xl mx-auto mb-12">
          When an agent forgets, you look for the fix under memory. HiveMind is that, plus two things memory tools do not keep.
        </p>
        <div class="grid sm:grid-cols-2 gap-6">
          <div class="rounded-lg bg-info-soft p-6">
            <h3 class="text-md font-semibold text-foreground mb-2">The why</h3>
            <p class="text-base text-muted-foreground leading-relaxed">
              The options, the evidence, and who decided, a person or an agent.
            </p>
          </div>
          <div class="rounded-lg bg-success-soft p-6">
            <h3 class="text-md font-semibold text-foreground mb-2">Whether it held up</h3>
            <p class="text-base text-muted-foreground leading-relaxed">
              A status that follows from later contest and supersession, not a label somebody has to
              remember to update. Old decisions are never edited or deleted; the history stays.
            </p>
          </div>
        </div>
        <p class="text-sm text-muted-foreground text-center mt-10 max-w-xl mx-auto">
          HiveMind is early: self-hosted only, with no hosted version and no sign-up.
          The code is on <a href="https://github.com/alexknips/hivemind" class="link">GitHub</a> under AGPL-3.0.
        </p>
      </div>
    </section>

    <!-- Bottom CTA -->
    <section class="border-t border-border">
      <div class="max-w-6xl mx-auto px-4 sm:px-6 py-20 sm:py-24 text-center">
        <h2 class="text-xl font-semibold tracking-tight text-foreground mb-3">Start with one decision</h2>
        <p class="text-md text-muted-foreground mb-10 max-w-lg mx-auto">
          Install it, connect your agent, and record the next thing you decide together.
        </p>
        <div class="flex flex-col sm:flex-row gap-3 justify-center">
          <a href="#self-host" class="btn btn-primary btn-lg">
            Self-host it &rarr;
          </a>
          <a href={`${base}demo/`} class="btn btn-outline btn-lg">
            Explore a real decision &rarr;
          </a>
          <a href={`${base}getting-started/quickstart/`} class="btn btn-outline btn-lg">
            Read the docs
          </a>
        </div>
      </div>
    </section>

  </main>

  <!-- Footer -->
  <footer class="border-t border-border py-12">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 flex flex-col sm:flex-row items-center justify-between gap-4">
      <div class="text-sm text-muted-foreground">
        HiveMind &mdash; memory for decisions
      </div>
      <div class="flex flex-wrap items-center justify-center gap-x-6 gap-y-2 text-sm text-muted-foreground">
        <a href={`${base}getting-started/quickstart/`} class="hover:text-foreground transition-colors">Docs</a>
        <a href={`${base}use-cases/`} class="hover:text-foreground transition-colors">Use cases</a>
        <a href={`${base}pitch/`} class="hover:text-foreground transition-colors">Why HiveMind</a>
        <a href="https://github.com/alexknips/hivemind" class="hover:text-foreground transition-colors">GitHub</a>
      </div>
    </div>
  </footer>

</body>
</html>
