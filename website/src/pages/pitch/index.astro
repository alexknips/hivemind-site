---
// The deck: one slide per screen, left to right; on a phone the slides stack.
// Static markup with its own layout and script, painted from the site's tokens.
// Since 2026-10-03 (the founder's call): eight slides that say the value and who it is for,
// no install commands, and the site's graphs where the "did it hold up?" screenshot was.
// A story with steps plays in one frame: the arrow key steps it first, then moves on.
import '@fontsource-variable/inter';
import '../../styles/tokens.css';
import '../../styles/graphs.css';
import ThemeInit from '../../components/ThemeInit.astro';
import Frame from '../../components/graphs/Frame.astro';
import {
  anatomyAlt,
  anatomyNarrow,
  anatomyParts,
  anatomyWide,
  storyAssumption,
  storyWhoAgents,
} from '../../data/graph-stories';

const base = import.meta.env.BASE_URL;
const partLines = JSON.stringify(Object.fromEntries(anatomyParts.map((p) => [p.id, p.line])));
const who = storyWhoAgents.steps[0];
// The café stops before the opening moves: a wrong assumption and what rested on it, nothing replaced.
const cafe = storyAssumption.steps.slice(0, 2);
---
<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>HiveMind — memory for decisions</title>
<meta name="description" content="HiveMind is memory for decisions. Your coding agents record what was decided, which options lost and why, and who decided, you or the agent. Early, self-hosted, AGPL-3.0.">
<meta property="og:title" content="HiveMind — memory for decisions">
<meta property="og:description" content="Your coding agents record what was decided, which options lost and why, and who decided, you or the agent. Early, self-hosted, AGPL-3.0.">
<meta property="og:type" content="website">
<meta property="og:url" content="https://alexknips.github.io/hivemind-site/pitch/">
<meta name="twitter:card" content="summary">
<meta name="twitter:title" content="HiveMind — memory for decisions">
<meta name="twitter:description" content="Your coding agents record what was decided, which options lost and why, and who decided. Early, self-hosted, AGPL-3.0.">
<link rel="icon" type="image/svg+xml" href="/hivemind-site/favicon.svg">
<ThemeInit />
<style is:global>
  /* The deck's colours are the site's design tokens (tokens.css): the same
     neutrals and link accent as every other page, light or dark with the OS,
     or as picked in the docs' theme menu. */
  :root{
    --edge:1px solid var(--border);
    /* The terminal frame stays dark in both schemes, like the screenshots in it. */
    --term:#17181C; --term-edge:#2C2F38; --term-dot:#3A3D48; --term-title:#9A9FAB;
  }

  *{box-sizing:border-box}
  html,body{margin:0;height:100%}
  ul{list-style:none;margin:0;padding:0}
  body{
    background:var(--background); color:var(--foreground); font-family:var(--font-sans);
    -webkit-font-smoothing:antialiased; overflow:hidden;
  }
  a{color:var(--link)}
  code{font-family:var(--font-mono); font-size:.92em}

  /* ---- top rail ---- */
  .rail{
    position:fixed; inset:0 0 auto 0; height:44px; z-index:30;
    display:flex; align-items:center; justify-content:space-between; gap:16px;
    padding:0 clamp(16px,4vw,44px); font-family:var(--font-mono);
    font-size:12px; letter-spacing:.14em; text-transform:uppercase;
    color:var(--muted-foreground); background:linear-gradient(var(--background),var(--background) 60%,transparent);
  }
  .rail .mark{display:flex; align-items:center; gap:8px; color:var(--foreground); text-decoration:none;
    font-family:var(--font-sans); font-size:var(--text-md); font-weight:600; letter-spacing:-.01em; text-transform:none}
  .rail .mark svg{width:20px; height:20px; color:var(--link)}
  .rail .prog{display:flex; align-items:center; gap:10px}
  .rail .bar{width:120px; height:2px; background:var(--border); position:relative}
  .rail .bar i{position:absolute; inset:0 auto 0 0; width:0; background:var(--link); transition:width .4s ease}

  /* ---- deck: one slide per screen, left to right ---- */
  .deck{
    display:flex; height:100%; overflow-x:auto; overflow-y:hidden;
    scroll-snap-type:x mandatory; scroll-behavior:smooth; scrollbar-width:none;
  }
  .deck::-webkit-scrollbar{display:none}
  .deck:focus{outline:none}
  .slide{
    flex:0 0 100vw; height:100svh; min-height:100%;
    scroll-snap-align:start; scroll-snap-stop:always;
    display:flex; align-items:center;
    padding:60px clamp(20px,6vw,110px) 76px;
    position:relative;
  }
  .wrap{width:min(1080px,100%); margin:0 auto}

  .eyebrow{
    font-family:var(--font-mono); font-size:clamp(.7rem,1.4vw,.8rem);
    letter-spacing:.22em; text-transform:uppercase; color:var(--link);
    display:flex; align-items:center; gap:12px; margin:0 0 20px;
  }
  .eyebrow::before{content:""; width:26px; height:0; border-top:2px solid var(--link); flex:none}
  .eyebrow .dim{color:var(--muted-foreground)}

  h1,h2{margin:0}
  .claim{
    font-family:var(--font-mono); font-weight:600; letter-spacing:-.02em;
    line-height:1.08; text-wrap:balance;
    font-size:clamp(1.8rem,4.6vw,3.6rem);
  }
  .claim .hl{color:var(--link)}
  .lede{
    font-size:clamp(1.02rem,1.9vw,1.3rem); line-height:1.55; color:var(--muted-foreground);
    max-width:62ch; margin:24px 0 0;
  }
  .lede b{color:var(--foreground); font-weight:600}
  .kick{
    margin:28px 0 0; font-family:var(--font-mono); font-size:clamp(.92rem,1.6vw,1.06rem);
    color:var(--foreground); border-left:3px solid var(--link); padding:4px 0 4px 16px;
    max-width:60ch; line-height:1.5;
  }

  /* cover */
  .cover .wordmark{
    font-family:var(--font-mono); font-weight:600; font-size:clamp(2.6rem,7vw,5.2rem);
    letter-spacing:-.02em; line-height:1;
  }
  .cover .wordmark b{color:var(--link)}
  .cover .sub{
    font-size:clamp(1.1rem,2.4vw,1.6rem); color:var(--muted-foreground);
    margin:26px 0 0; max-width:34ch; line-height:1.4;
  }
  .cover .meta{
    margin-top:44px; padding-top:18px; border-top:var(--edge);
    display:flex; flex-wrap:wrap; gap:10px 26px; font-family:var(--font-mono);
    font-size:12px; letter-spacing:.12em; text-transform:uppercase; color:var(--muted-foreground);
  }
  .cover .meta b{color:var(--foreground); font-weight:600}

  /* ledger list */
  .ledger{margin:30px 0 0; display:grid; max-width:78ch}
  .ledger li{
    display:grid; grid-template-columns:9.5em 1fr; gap:16px; align-items:baseline;
    padding:14px 0; border-top:var(--edge); font-size:clamp(.98rem,1.55vw,1.1rem); line-height:1.5;
  }
  .ledger li:last-child{border-bottom:var(--edge)}
  .ledger .k{
    font-family:var(--font-mono); font-size:.74em; letter-spacing:.1em; text-transform:uppercase;
    color:var(--link);
  }
  .ledger .v b{font-weight:600}

  /* two cards */
  .pair{display:grid; grid-template-columns:1fr 1fr; gap:18px; margin:30px 0 0; max-width:880px}
  .card{background:var(--muted); border:var(--edge); border-radius:6px; padding:20px 22px}
  .card h3{margin:0 0 8px; font-family:var(--font-mono); font-size:1.02rem}
  .card p{margin:0; color:var(--muted-foreground); line-height:1.55}

  /* screenshot slides: words on the left, the real terminal on the right */
  .shot{display:grid; grid-template-columns:minmax(260px,380px) auto; gap:clamp(28px,4vw,60px);
    align-items:center; justify-content:center}
  .shot .claim{font-size:clamp(1.7rem,3.1vw,2.6rem)}
  .shot .lede{font-size:clamp(1rem,1.5vw,1.14rem)}
  .note{
    margin:22px 0 0; font-family:var(--font-mono); font-size:.78rem; line-height:1.55;
    color:var(--muted-foreground); letter-spacing:.02em; max-width:44ch;
  }
  .ledger + .note{max-width:78ch}
  .term{
    margin:0; background:var(--term); border:1px solid var(--term-edge); border-radius:10px;
    box-shadow:0 18px 50px -24px #0009; overflow:hidden; justify-self:start;
  }
  .term .bar{
    height:28px; display:flex; align-items:center; gap:7px; padding:0 12px;
    border-bottom:1px solid var(--term-edge);
  }
  .term .bar i{width:10px; height:10px; border-radius:50%; background:var(--term-dot)}
  .term .bar span{margin-left:8px; font-family:var(--font-mono); font-size:11px; color:var(--term-title); letter-spacing:.04em}
  .term a{display:block}
  .term img{display:block; width:auto; height:auto; max-width:100%;
    max-height:calc(100svh - 60px - 76px - 30px)}

  /* the ask */
  .steps{margin:26px 0 0; display:grid; gap:0; max-width:940px}
  .steps li{display:grid; grid-template-columns:5.5em 1fr; gap:16px; padding:16px 0; border-top:var(--edge); align-items:baseline}
  .steps li:last-child{border-bottom:var(--edge)}
  .steps .k{font-family:var(--font-mono); font-size:.8em; letter-spacing:.1em; text-transform:uppercase; color:var(--link)}
  .steps p{margin:0; line-height:1.55}
  .steps pre{
    margin:10px 0; padding:10px 12px; background:var(--muted); border:var(--edge); border-radius:4px;
    font-family:var(--font-mono); font-size:.84rem; line-height:1.5;
    white-space:pre-wrap; overflow-wrap:anywhere;
  }
  .claim.ask{font-size:clamp(1.7rem,3.6vw,2.9rem); max-width:24ch}
  .status{
    margin:24px 0 0; font-family:var(--font-mono); font-size:.8rem; letter-spacing:.06em;
    color:var(--muted-foreground); display:flex; flex-wrap:wrap; gap:6px 18px;
  }
  .status b{color:var(--foreground); font-weight:600}
  .links{margin:18px 0 0; display:flex; flex-wrap:wrap; gap:10px 22px; font-family:var(--font-mono); font-size:.86rem}

  /* a smaller headline on slides that carry a picture */
  .claim.mid{font-size:clamp(1.6rem,2.9vw,2.4rem)}

  /* what you get: the anatomy of a decision, then three values under it */
  .anat{margin:22px 0 0}
  .anat .hg{max-height:calc(100svh - 470px)}
  .anat-narrow{display:none; max-width:26rem}
  .anat-line{margin:10px 0 0; min-height:1.5em; font-size:.92rem; line-height:1.5; color:var(--muted-foreground)}
  .values{display:grid; grid-template-columns:repeat(3,minmax(0,1fr)); gap:18px 28px; margin:18px 0 0}
  .values li{border-top:2px solid var(--link); padding-top:10px}
  .values h3{margin:0 0 4px; font-family:var(--font-mono); font-size:.98rem}
  .values p{margin:0; color:var(--muted-foreground); line-height:1.5; font-size:.98rem}
  .values + .kick{margin-top:22px}

  /* Claude Code: two real sessions side by side, each cut to the part that carries the point;
     both start at the prompt, under Claude Code's banner (y 180 of 1160 wide). The link opens all of it. */
  .twoshots{display:grid; grid-template-columns:repeat(2,minmax(0,1fr)); gap:clamp(18px,2.4vw,32px); margin:22px 0 0; align-items:start}
  .twoshots figure{margin:0; min-width:0; width:min(100%, calc((100svh - 400px) * 1160 / 1140))}
  .twoshots figcaption{margin:12px 0 0; font-size:clamp(.95rem,1.3vw,1.04rem); line-height:1.5; color:var(--muted-foreground)}
  .twoshots figcaption b{color:var(--foreground); font-weight:600}
  .crop{display:block; overflow:hidden}
  .term .crop img{width:100%; max-width:none; max-height:none; margin-top:-15.5%}
  .crop--capture{aspect-ratio:1160/770}
  .crop--why{aspect-ratio:1160/1140}
  .twoshots + .note{max-width:none}

  /* graph stories: the words on the left, the drawing large on the right */
  .story{display:grid; grid-template-columns:minmax(280px,420px) minmax(0,1fr); gap:clamp(28px,4vw,60px); align-items:center}
  .story .lede{font-size:clamp(1rem,1.45vw,1.12rem); margin-top:18px}
  .story-stage{min-width:0; margin:0}
  .story-stage .hg{max-height:calc(100svh - 250px)}
  .story-stage figcaption{margin:12px 0 0; font-size:clamp(.95rem,1.3vw,1.04rem); line-height:1.5; color:var(--muted-foreground)}
  .key{margin:18px 0 0; display:flex; flex-wrap:wrap; gap:8px 18px; font-size:.92rem}
  .key span{display:inline-flex; align-items:center; gap:8px}
  /* a story's steps sit in one frame; a step that has passed stays under the next one */
  .steps-stage{display:grid}
  .steps-stage .step{grid-area:1/1; margin:0; min-width:0; opacity:0; transition:opacity .45s ease}
  .steps-stage .step.is-on, .steps-stage .step.is-past{opacity:1}
  .steps-stage .step.is-past figcaption{opacity:0}
  .step-label{display:none; margin:0 0 8px; font-family:var(--font-mono); font-size:12px; color:var(--muted-foreground)}
  .stepper{display:flex; flex-wrap:wrap; gap:8px; margin:22px 0 0}
  .stepper button{
    font-family:var(--font-mono); font-size:12px; letter-spacing:.06em; color:var(--foreground);
    background:var(--muted); border:var(--edge); border-radius:2px; padding:7px 10px; cursor:pointer;
  }
  .stepper button[aria-pressed="true"]{background:var(--primary); border-color:var(--primary); color:var(--primary-foreground)}
  .stepper + .tnav{margin:10px 0 0; font-family:var(--font-mono); font-size:12px; color:var(--muted-foreground)}

  /* lighting up: what a step changes flashes once as it arrives */
  @keyframes hg-flash{30%{stroke-width:7}}
  @keyframes hg-in{from{opacity:0}}
  .step.is-on .hg-node.is-look .hg-shape,
  .step.is-on .hg-node.is-refuted .hg-shape,
  .slide.is-here .hg-node.hg-who--claude .hg-shape,
  .slide.is-here .hg-node.hg-who--codex .hg-shape{animation:hg-flash 1.3s ease-out .35s}
  .step.is-on .hg-badge, .step.is-on .hg-node.is-lit{animation:hg-in .5s ease .2s backwards}
  .steps-stage .step:first-child .hg-node.is-lit{animation:none}

  /* who it is for */
  .traits{margin:28px 0 0; display:grid; max-width:960px}
  .traits li{
    display:grid; grid-template-columns:minmax(0,1fr) minmax(0,1.3fr); gap:4px 28px; align-items:baseline;
    padding:13px 0; border-top:var(--edge); font-size:clamp(.98rem,1.5vw,1.08rem); line-height:1.5;
  }
  .traits li:last-child{border-bottom:var(--edge)}
  .traits b{font-weight:600}
  .traits span{color:var(--muted-foreground)}
  .steps .go{margin:10px 0 0; font-family:var(--font-mono); font-size:.9rem}

  @media (prefers-reduced-motion:reduce){
    .steps-stage .step{transition:none}
    .deck .hg-shape, .deck .hg-badge, .deck .hg-node, .deck .step{animation:none !important}
  }

  /* ---- nav ---- */
  .nav{
    position:fixed; inset:auto 0 0 0; height:56px; z-index:30;
    display:flex; align-items:center; justify-content:space-between;
    padding:0 clamp(16px,4vw,44px);
    background:linear-gradient(transparent,var(--background) 45%);
    font-family:var(--font-mono); font-size:12px; color:var(--muted-foreground); letter-spacing:.1em;
  }
  .dots{display:flex; gap:9px}
  .dots button{
    width:9px; height:9px; padding:0; border:1px solid var(--muted-foreground); background:transparent;
    border-radius:50%; cursor:pointer; transition:all .25s;
  }
  .dots button[aria-current="true"]{background:var(--link); border-color:var(--link); transform:scale(1.15)}
  .arrows{display:flex; gap:8px}
  .arrows button{
    font-family:var(--font-mono); font-size:13px; color:var(--foreground); background:var(--muted);
    border:var(--edge); border-radius:2px; width:38px; height:32px; cursor:pointer;
  }
  .arrows button:hover{border-color:var(--link); color:var(--link)}
  .arrows button:disabled{opacity:.4; cursor:default}
  .count b{color:var(--foreground)}
  :focus-visible{outline:2px solid var(--link); outline-offset:3px}

  /* short desktop windows: the screenshot slides get the room */
  @media (min-width:900px) and (max-height:760px){
    .slide{padding-top:52px; padding-bottom:64px}
    .term img{max-height:calc(100svh - 52px - 64px - 30px)}
  }

  /* phones and narrow windows: slides stack and the page scrolls down */
  @media (max-width:899px){
    body{overflow:auto; height:auto}
    html{height:auto}
    .rail{position:static; background:var(--background); border-bottom:var(--edge)}
    .rail .prog{display:none}
    .deck{display:block; height:auto; overflow:visible}
    .slide{height:auto; min-height:0; padding:44px 16px 52px; border-bottom:var(--edge); display:block}
    .slide.cover{padding-top:64px; padding-bottom:72px}
    .nav{display:none}
    .shot{grid-template-columns:1fr; gap:22px}
    .term{justify-self:stretch}
    .term img{width:100%; max-height:none}
    .pair{grid-template-columns:1fr}
    .ledger li{grid-template-columns:1fr; gap:4px}
    .steps li{grid-template-columns:1fr; gap:6px}
    .tnav{display:none}
    .anat-wide{display:none}
    .anat-narrow{display:block}
    .anat .hg, .story-stage .hg{max-height:none}
    .values{grid-template-columns:1fr}
    .twoshots{grid-template-columns:1fr; gap:28px}
    .twoshots figure{width:100%}
    .story{grid-template-columns:1fr; gap:22px}
    .steps-stage{gap:26px}
    .steps-stage .step{grid-area:auto; opacity:1}
    .steps-stage .step figcaption{opacity:1}
    .step-label{display:block}
    .stepper{display:none}
    .traits li{grid-template-columns:1fr; gap:2px}
  }
</style>
</head>
<body>

<header class="rail">
  <a class="mark" href="/hivemind-site/">
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect width="7" height="7" x="14" y="3" rx="1"/><path d="M10 21V8a1 1 0 0 0-1-1H4a1 1 0 0 0-1 1v12a1 1 0 0 0 1 1h12a1 1 0 0 0 1-1v-5a1 1 0 0 0-1-1H3"/></svg>
    HiveMind
  </a>
  <span class="prog"><span id="railnum">00 / 07</span><span class="bar"><i id="railbar"></i></span></span>
</header>

<main class="deck" id="deck" tabindex="0" aria-label="HiveMind, a short deck. Use the arrow keys to move between slides.">

  <!-- 00 cover -->
  <section class="slide cover" aria-label="Cover">
    <div class="wrap">
      <p class="eyebrow">For friends and early users</p>
      <h1 class="wordmark">Hive<b>Mind</b></h1>
      <p class="sub">Memory for decisions, for you and your agents.</p>
      <div class="meta">
        <span><b>Early</b></span>
        <span><b>Self-hosted</b></span>
        <span>AGPL-3.0</span>
        <span class="tnav">→ arrow keys to move</span>
      </div>
    </div>
  </section>

  <!-- 01 the problem, in plain words (as on the landing page since 2026-09-29), with "your agents" plural
       since 2026-10-03; under it one engineer's own words (dev.to, 9 Sep 2026) -->
  <section class="slide" aria-label="The problem">
    <div class="wrap">
      <p class="eyebrow">The problem</p>
      <h2 class="claim">Your agents forget<br>what you <span class="hl">decided.</span></h2>
      <ul class="ledger">
        <li><span class="k">It undid it</span><span class="v">You ruled an option out, for a reason. A fresh session, or your other agent, never heard about it and suggests it again, with confidence.</span></li>
        <li><span class="k">Nobody knows why</span><span class="v">You talked it through with your agent, and the chat was the meeting. Once it closes, the reasons are gone, and so is who made the call.</span></li>
        <li><span class="k">Did it hold up?</span><span class="v">Plans change. The notes still say the old thing, the agent follows it, and nobody can tell which decisions still stand.</span></li>
      </ul>
      <p class="note">“It rediscovered the same ‘improvement’ every few weeks, like a groundhog day of well-intentioned regressions.” <a href="https://dev.to/yureki_lab/how-i-taught-my-ai-coding-agent-to-stop-undoing-my-design-decisions-2o38">An engineer on dev.to</a>, September 2026</p>
    </div>
  </section>

  <!-- 02 what you get: the anatomy of a decision (the landing page's drawing; hover or tap a part),
       then the three things it is worth to you -->
  <section class="slide" aria-label="What you get">
    <div class="wrap">
      <p class="eyebrow">What you get</p>
      <h2 class="claim mid">Decide once. Every agent can <span class="hl">ask why.</span></h2>
      <div class="anat hg-anatomy" data-anatomy data-lines={partLines}>
        <div class="anat-wide"><Frame frame={anatomyWide} alt={anatomyAlt} /></div>
        <div class="anat-narrow"><Frame frame={anatomyNarrow} alt={anatomyAlt} /></div>
        <p class="anat-line" data-part-line aria-live="polite">One decision and its parts: here, a café changes its coffee supplier. Hover or tap a part to read what it is.</p>
      </div>
      <ul class="values">
        <li><h3>No re-explaining</h3><p>Each decision keeps the options that lost and why. A new session, or a different agent, asks the record, not you.</p></li>
        <li><h3>Your calls stay yours</h3><p>Each record says who decided: you, or the agent.</p></li>
        <li><h3>What rests on what</h3><p>Each decision shows the evidence and the assumptions under it.</p></li>
      </ul>
      <p class="kick">Claude Code, Codex and Cursor share one record in your project. Any decision you make with an agent fits, not only code. Running it today takes a developer's setup.</p>
    </div>
  </section>

  <!-- 03 two real Claude Code sessions on one slide: recording a decision, then a fresh session asking why -->
  <section class="slide" aria-label="In Claude Code: say it once, ask any time">
    <div class="wrap">
      <p class="eyebrow">In Claude Code</p>
      <h2 class="claim mid">Say it once. <span class="hl">Ask any time.</span></h2>
      <div class="twoshots">
        <figure>
          <div class="term">
            <div class="bar" aria-hidden="true"><i></i><i></i><i></i><span>~/code/pantry</span></div>
            <a class="crop crop--capture" href="img/capture.png"><img src="img/capture.png" width="1160" height="1158"
              alt="Claude Code session in ~/code/pantry. The user writes: We need real storage for pantry. My call: SQLite, one file next to the app. Postgres is overkill for a one-person app, it's a server to run and back up. The JSON file we have now loses writes when two requests land at once. Record the decision in HiveMind. The agent calls HiveMind once and replies: I saved the decision in HiveMind and marked it accepted. Chosen: SQLite, as a single file next to the app. Also listed: Postgres, turned down as overkill because it's a server to run and back up; keeping the JSON file, turned down because it loses writes when two requests arrive at once. Decided by: human:you@example.com. Your own words are attached as the quote. Topics: pantry, storage, database."></a>
          </div>
          <figcaption>You make the call. The agent writes it down: the options that lost, the reasons, and that <b>you</b> decided.</figcaption>
        </figure>
        <figure>
          <div class="term">
            <div class="bar" aria-hidden="true"><i></i><i></i><i></i><span>~/code/pantry</span></div>
            <a class="crop crop--why" href="img/why.png"><img src="img/why.png" width="1160" height="1816"
              alt="A fresh Claude Code session. The user asks: Why is pantry on SQLite and not Postgres? What did we rule out? The agent calls HiveMind and replies: It was your decision, recorded in HiveMind as Use SQLite (single file next to the app) for pantry storage. Its status is accepted and nothing has replaced it. It quotes the user's own words, lists the options ruled out (Postgres: too much for a one-person app, another server to run and back up; keeping the JSON file: it was losing writes), explains why SQLite, and notes that no evidence is attached to the decision."></a>
          </div>
          <figcaption>A fresh session asks why. The answer comes from the record: your words, what you ruled out, and that nothing replaced it.</figcaption>
        </figure>
      </div>
      <p class="note">A real session in pantry, a small demo app. Everything shown is in v0.7.0. Open a screenshot to read all of it.</p>
    </div>
  </section>

  <!-- 04 who decided: the landing's drawing with two agents at work, coloured by which one made the call -->
  <section class="slide" aria-label="Who decided">
    <div class="wrap story">
      <div>
        <p class="eyebrow">Who decided</p>
        <h2 class="claim mid">More than one agent, one record. You can see <span class="hl">whose call it was.</span></h2>
        <p class="lede">{who.caption}</p>
        <p class="key">
          <span><i class="hg-swatch hg-swatch--you" aria-hidden="true"></i> you decided</span>
          <span><i class="hg-swatch hg-swatch--claude" aria-hidden="true"></i> Claude, on its own</span>
          <span><i class="hg-swatch hg-swatch--codex" aria-hidden="true"></i> Codex, on its own</span>
        </p>
        <p class="note">The record holds who decided, down to the agent. The colours are this drawing's.</p>
      </div>
      <figure class="story-stage"><Frame frame={who.frame} alt={who.alt} /></figure>
    </div>
  </section>

  <!-- 05 when you were wrong: the café, two steps in one frame; it stops before anything is replaced -->
  <section class="slide" aria-label="When you were wrong">
    <div class="wrap story">
      <div>
        <p class="eyebrow">When you were wrong</p>
        <h2 class="claim mid">One wrong assumption, and everything that rested on it, <span class="hl">in view.</span></h2>
        <div class="stepper" role="group" aria-label="Steps of the story">
          {cafe.map((step, n) => (
            <button type="button" data-step-btn={n} aria-pressed={n === 0 ? 'true' : 'false'}>{n + 1} · {step.label}</button>
          ))}
        </div>
        <p class="tnav">→ steps through the story, then moves on</p>
        <p class="kick">The wrong assumption stays on the record, as evidence for the next call.</p>
      </div>
      <div class="story-stage steps-stage">
        {cafe.map((step, n) => (
          <figure class:list={['step', n === 0 && 'is-on']} data-step={n}>
            <p class="step-label">{n + 1} · {step.label}</p>
            <Frame frame={step.frame} alt={step.alt} />
            <figcaption>{step.caption}</figcaption>
          </figure>
        ))}
      </div>
    </div>
  </section>

  <!-- 06 who it is for: the person, described by what they value (the founder's words, 2026-10-03) -->
  <section class="slide" aria-label="Who it is for">
    <div class="wrap">
      <p class="eyebrow">Who it is for</p>
      <h2 class="claim">For people who treat a mistake <span class="hl">as evidence.</span></h2>
      <ul class="traits">
        <li><b>You want the truth, even when it's awkward.</b><span>You'd rather see the assumption that was wrong than a tidy document that hides it.</span></li>
        <li><b>You learn from being wrong.</b><span>A wrong call is the most useful thing you learned. You keep it, with the reason.</span></li>
        <li><b>You don't make a mistake twice.</b><span>And you don't want your agents to repeat the one you already paid for.</span></li>
        <li><b>You run more than one agent.</b><span>Claude Code in one terminal, Codex in another, and you're the only thing they share.</span></li>
        <li><b>You make the calls.</b><span>Your agents do the work. The judgment is yours.</span></li>
      </ul>
      <p class="kick">It isn't for watching anyone else. It's for people who check their own work.</p>
    </div>
  </section>

  <!-- 07 the ask: no install commands on the slide since 2026-10-03; the Quickstart has them -->
  <section class="slide" aria-label="One ask">
    <div class="wrap">
      <p class="eyebrow">One ask</p>
      <h2 class="claim ask">Try it on one project, or tell me how you <span class="hl">do this today.</span></h2>
      <ul class="steps">
        <li><span class="k">Try it</span><div>
          <p>Record the next thing you and your agent decide. A week later, ask why from a fresh session, and tell me where it breaks.</p>
          <p class="go"><a href={`${base}getting-started/quickstart/`}>The Quickstart →</a></p>
        </div></li>
        <li><span class="k">Or talk</span><div>
          <p>Twenty minutes on how you keep your agents from repeating your mistakes. Reply to whoever sent you this, or open an issue on GitHub.</p>
        </div></li>
      </ul>
      <p class="status"><span><b>Status:</b> early</span><span>self-hosted only, Linux and Apple Silicon Macs</span><span>no hosted version, no sign-up</span><span>AGPL-3.0</span></p>
      <p class="links">
        <a href={`${base}#self-host`}>Self-host guide</a>
        <a href={`${base}getting-started/quickstart/`}>Docs</a>
        <a href="https://github.com/alexknips/hivemind">GitHub</a>
      </p>
    </div>
  </section>

</main>

<nav class="nav" aria-label="Deck controls">
  <span class="count">SLIDE <b id="cur">00</b> / <span id="last">07</span></span>
  <div class="dots" id="dots" role="tablist" aria-label="Slides"></div>
  <div class="arrows">
    <button id="prev" aria-label="Previous slide">←</button>
    <button id="next" aria-label="Next slide">→</button>
  </div>
</nav>

<script is:inline>
  const deck=document.getElementById('deck');
  const slides=[...deck.querySelectorAll('.slide')];
  const dotsWrap=document.getElementById('dots');
  const cur=document.getElementById('cur'), railnum=document.getElementById('railnum'), railbar=document.getElementById('railbar');
  const prev=document.getElementById('prev'), next=document.getElementById('next');
  const N=slides.length, last=String(N-1).padStart(2,'0'); let i=0;
  document.getElementById('last').textContent=last;
  const stacked=matchMedia('(max-width:899px)');

  slides.forEach((s,n)=>{
    const b=document.createElement('button');
    b.setAttribute('role','tab'); b.setAttribute('aria-label','Go to slide '+String(n).padStart(2,'0'));
    b.addEventListener('click',()=>go(n));
    dotsWrap.appendChild(b);
  });
  const dots=[...dotsWrap.children];

  // A slide with a story in steps: the arrow keys step it first, then move to the next slide.
  const stories=slides.map(s=>{
    const steps=[...s.querySelectorAll('.step')];
    if(steps.length<2) return null;
    const st={steps,btns:[...s.querySelectorAll('[data-step-btn]')],k:0};
    st.btns.forEach((b,n)=>b.addEventListener('click',()=>{step(st,n); paint();}));
    return st;
  });
  function step(st,k){
    st.k=k;
    st.steps.forEach((el,n)=>{
      el.classList.toggle('is-on',n===k); el.classList.toggle('is-past',n<k);
      if(stacked.matches) el.removeAttribute('aria-hidden'); else el.setAttribute('aria-hidden',String(n!==k));
    });
    st.btns.forEach((b,n)=>b.setAttribute('aria-pressed',String(n===k)));
  }
  stories.forEach(st=>st&&step(st,0));
  function forward(){
    const st=stories[i];
    if(st&&!stacked.matches&&st.k<st.steps.length-1) step(st,st.k+1); else go(i+1);
  }
  function back(){
    const st=stories[i];
    if(st&&!stacked.matches&&st.k>0) step(st,st.k-1); else go(i-1);
  }

  function pad(n){return String(n).padStart(2,'0')}
  function paint(){
    cur.textContent=pad(i);
    railnum.textContent=pad(i)+' / '+last;
    railbar.style.width=(N<2?100:(i/(N-1))*100)+'%';
    dots.forEach((d,n)=>d.setAttribute('aria-current',n===i?'true':'false'));
    const st=stories[i];
    prev.disabled=i===0&&!(st&&st.k>0); next.disabled=i===N-1&&!(st&&st.k<st.steps.length-1);
    slides.forEach((s,n)=>s.classList.toggle('is-here',n===i));
  }
  function go(n){
    n=Math.max(0,Math.min(N-1,n));
    // Coming into a story from before it starts it at the beginning; coming back, at its end.
    if(n!==i&&stories[n]) step(stories[n],n>i?0:stories[n].steps.length-1);
    i=n;
    slides[i].scrollIntoView({behavior:'smooth',inline:'start',block:stacked.matches?'start':'nearest'});
    paint();
  }

  next.addEventListener('click',()=>{forward(); paint();});
  prev.addEventListener('click',()=>{back(); paint();});

  addEventListener('keydown',e=>{
    if(stacked.matches) return;
    if(e.key==='ArrowRight'||e.key==='PageDown'||e.key===' '){e.preventDefault();forward();paint();}
    else if(e.key==='ArrowLeft'||e.key==='PageUp'){e.preventDefault();back();paint();}
    else if(e.key==='Home'){e.preventDefault();go(0);}
    else if(e.key==='End'){e.preventDefault();go(N-1);}
  });

  let t; deck.addEventListener('scroll',()=>{
    clearTimeout(t); t=setTimeout(()=>{
      const n=Math.round(deck.scrollLeft/deck.clientWidth);
      if(n!==i){ i=n; paint(); }
    },90);
  },{passive:true});

  // The anatomy: hover or tap a part of the graph to read one line about it; tap again to let go.
  for(const root of document.querySelectorAll('[data-anatomy]')){
    const line=root.querySelector('[data-part-line]'), idle=line.textContent, lines=JSON.parse(root.dataset.lines);
    const parts=[...root.querySelectorAll('.hg [data-part]')];
    let pinned=null;
    const show=part=>{
      if(!part){ delete root.dataset.on; parts.forEach(el=>el.classList.remove('is-on')); line.textContent=idle; return; }
      root.dataset.on=part;
      parts.forEach(el=>el.classList.toggle('is-on',(el.dataset.part||'').split(' ').includes(part)));
      line.textContent=lines[part]||idle;
    };
    for(const el of parts){
      const part=(el.dataset.part||'').split(' ')[0];
      el.addEventListener('click',()=>{ pinned=pinned===part?null:part; show(pinned); });
      el.addEventListener('pointerenter',e=>{ if(e.pointerType==='mouse') show(part); });
      el.addEventListener('pointerleave',e=>{ if(e.pointerType==='mouse') show(pinned); });
    }
  }

  if(!stacked.matches) deck.focus({preventScroll:true});
  paint();
</script>
</body>
</html>
