---
import '../styles/global.css';
const base = import.meta.env.BASE_URL;
const installCmd = 'curl -fsSL https://raw.githubusercontent.com/alexknips/hivemind/master/scripts/install.sh | sh';
const connectCmd = 'claude mcp add hivemind -- hivemind mcp';
---
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>HiveMind — memory for decisions</title>
  <meta name="description" content="HiveMind is memory for decisions. Your coding agents record what was decided, which options lost and why, and who decided, you or the agent. Local-first, AGPL-3.0, free to self-host." />
  <link rel="icon" type="image/svg+xml" href={`${base}favicon.svg`} />
</head>
<body class="bg-gray-950 text-gray-100 antialiased">

  <!-- Nav: wraps instead of overflowing; the text links drop out below sm -->
  <header class="border-b border-gray-800 sticky top-0 z-50 bg-gray-950/90 backdrop-blur">
    <nav class="max-w-6xl mx-auto px-4 sm:px-6 min-h-16 py-3 flex flex-wrap items-center justify-between gap-x-6 gap-y-2">
      <a href={base} class="flex items-center gap-2 font-bold text-lg text-white">
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
          <circle cx="12" cy="12" r="3" fill="#818cf8"/>
          <circle cx="4" cy="6" r="2" fill="#6366f1"/>
          <circle cx="20" cy="6" r="2" fill="#6366f1"/>
          <circle cx="4" cy="18" r="2" fill="#6366f1"/>
          <circle cx="20" cy="18" r="2" fill="#6366f1"/>
          <line x1="12" y1="12" x2="4" y2="6" stroke="#4f46e5" stroke-width="1.5"/>
          <line x1="12" y1="12" x2="20" y2="6" stroke="#4f46e5" stroke-width="1.5"/>
          <line x1="12" y1="12" x2="4" y2="18" stroke="#4f46e5" stroke-width="1.5"/>
          <line x1="12" y1="12" x2="20" y2="18" stroke="#4f46e5" stroke-width="1.5"/>
        </svg>
        HiveMind
      </a>
      <div class="flex flex-wrap items-center gap-x-5 gap-y-2">
        <a href={`${base}getting-started/quickstart/`} class="hidden sm:inline text-sm text-gray-400 hover:text-white transition-colors">Docs</a>
        <a href={`${base}demo/`} class="hidden sm:inline text-sm text-gray-400 hover:text-white transition-colors">Demo</a>
        <a href="https://github.com/alexknips/hivemind" class="text-sm text-gray-400 hover:text-white transition-colors">GitHub</a>
        <a href="#self-host" class="text-sm bg-indigo-600 hover:bg-indigo-500 text-white px-4 py-1.5 rounded-md transition-colors font-medium">
          Self-host &rarr;
        </a>
      </div>
    </nav>
  </header>

  <main>

    <!-- Hero: the positioning paragraph (vision/README.md, merged 2026-09-22), verbatim -->
    <section class="max-w-4xl mx-auto px-4 sm:px-6 pt-16 sm:pt-24 pb-16 sm:pb-20 text-center">
      <div class="inline-flex flex-wrap items-center justify-center gap-2 bg-indigo-950 border border-indigo-800 text-indigo-300 text-xs px-3 py-1.5 rounded-full mb-8">
        <span class="w-1.5 h-1.5 rounded-full bg-emerald-400"></span>
        v0.6.0 &middot; open source &middot; local-first
      </div>
      <h1 class="text-4xl sm:text-6xl font-bold text-white leading-tight mb-8">
        HiveMind is memory<br class="hidden sm:inline" /> <span class="text-indigo-400">for decisions.</span>
      </h1>
      <p class="text-lg sm:text-xl text-gray-300 max-w-2xl mx-auto mb-6 leading-relaxed">
        Your coding agents record what was decided, which options lost and why, and who decided,
        you or the agent. The next session does not reintroduce what you dropped or rewrite what
        you agreed. When a decision is contested or replaced, its status changes; nothing goes
        quietly stale.
      </p>
      <p class="text-base text-gray-400 max-w-2xl mx-auto mb-10">
        One engineer and their agents, local-first, AGPL-3.0, free to self-host.
      </p>

      <div class="flex flex-col sm:flex-row gap-3 justify-center mb-4">
        <a href="#self-host" class="bg-indigo-600 hover:bg-indigo-500 text-white px-6 py-3 rounded-lg font-semibold text-base transition-colors">
          Self-host it &rarr;
        </a>
        <a href={`${base}demo/`} class="bg-emerald-600 hover:bg-emerald-500 text-white px-6 py-3 rounded-lg font-semibold text-base transition-colors">
          Explore a real decision &rarr;
        </a>
      </div>
      <p class="text-sm text-gray-500">The demo is the jury room of <em>12 Angry Men</em> as a decision graph. No signup, no install.</p>
    </section>

    <!-- Self-host: the first step -->
    <section id="self-host" class="border-t border-gray-800 bg-gray-900/30 scroll-mt-20">
      <div class="max-w-3xl mx-auto px-4 sm:px-6 py-16 sm:py-20">
        <h2 class="text-3xl font-bold text-white text-center mb-4">Start on your own machine</h2>
        <p class="text-gray-400 text-center max-w-xl mx-auto mb-12">
          One binary and a local ledger in your project. No account, no API key, and nothing phones home.
        </p>

        <ol class="space-y-6">
          <li class="bg-gray-900 border border-gray-800 rounded-xl p-5 sm:p-6 min-w-0">
            <div class="flex items-baseline gap-3 mb-3">
              <span class="text-xs font-mono text-indigo-400">1</span>
              <h3 class="font-semibold text-white">Install HiveMind</h3>
            </div>
            <pre class="bg-gray-950 rounded-lg p-4 font-mono text-sm text-gray-300 overflow-x-auto mb-3"><code>{installCmd}</code></pre>
            <p class="text-gray-400 text-sm leading-relaxed">
              Linux (x86_64, ARM64) and Apple Silicon Macs. The script checks the release&rsquo;s SHA-256
              and puts <code class="text-indigo-300">hivemind</code> in <code class="text-indigo-300">~/.local/bin</code>.
              Elsewhere, <a href="https://github.com/alexknips/hivemind#install" class="text-indigo-300 hover:text-indigo-200 underline">build it with cargo</a>.
            </p>
          </li>
          <li class="bg-gray-900 border border-gray-800 rounded-xl p-5 sm:p-6 min-w-0">
            <div class="flex items-baseline gap-3 mb-3">
              <span class="text-xs font-mono text-indigo-400">2</span>
              <h3 class="font-semibold text-white">Connect your agent</h3>
            </div>
            <pre class="bg-gray-950 rounded-lg p-4 font-mono text-sm text-gray-300 overflow-x-auto mb-3"><code>{connectCmd}</code></pre>
            <p class="text-gray-400 text-sm leading-relaxed">
              Run it in your project for Claude Code. Decisions go to <code class="text-indigo-300">./hivemind/</code>,
              a SQLite ledger you own. Codex, Cursor and Claude Desktop are in
              <a href={`${base}guides/mcp-setup/`} class="text-indigo-300 hover:text-indigo-200 underline">MCP setup</a>.
            </p>
          </li>
          <li class="bg-gray-900 border border-gray-800 rounded-xl p-5 sm:p-6 min-w-0">
            <div class="flex items-baseline gap-3 mb-3">
              <span class="text-xs font-mono text-indigo-400">3</span>
              <h3 class="font-semibold text-white">Record a decision, then ask why</h3>
            </div>
            <div class="bg-gray-950 rounded-lg p-4 text-sm text-gray-300 space-y-2 mb-3">
              <p><span class="text-gray-500">You:</span> Record a decision: we use SQLite for the ledger. We considered Postgres and rejected it as premature.</p>
              <p><span class="text-gray-500">Later:</span> Why did we pick SQLite, and what did we rule out?</p>
            </div>
            <p class="text-gray-400 text-sm leading-relaxed">
              Your agent records it with the options and who decided, and answers from the record.
              The <a href={`${base}getting-started/quickstart/`} class="text-indigo-300 hover:text-indigo-200 underline">quickstart</a>
              walks through it.
            </p>
          </li>
        </ol>

        <p class="text-sm text-gray-500 text-center mt-8">
          Prefer a server to a local file?
          <a href={`${base}getting-started/install/`} class="text-indigo-300 hover:text-indigo-200 underline">Run a HiveMind cell with Docker Compose</a>.
        </p>
      </div>
    </section>

    <!-- The three failures, in the words people use (vision/README.md) -->
    <section class="max-w-6xl mx-auto px-4 sm:px-6 py-16 sm:py-20">
      <h2 class="text-3xl font-bold text-white text-center mb-4">Who decided what, why, and whether it held up</h2>
      <p class="text-gray-400 text-center max-w-xl mx-auto mb-12 sm:mb-16">
        Coding agents forget. These are the three ways it hurts, and what HiveMind keeps instead.
      </p>
      <div class="grid md:grid-cols-3 gap-6 sm:gap-8">
        <div class="bg-gray-900 border border-gray-800 rounded-xl p-6">
          <h3 class="font-semibold text-white mb-2">It undid what you decided</h3>
          <p class="text-gray-400 text-sm leading-relaxed mb-4">
            You dropped the ORM on purpose. A few weeks later the agent helpfully brings it back,
            with confidence.
          </p>
          <p class="text-gray-300 text-sm leading-relaxed">
            HiveMind keeps the options that lost and why they lost, next to the one you chose.
          </p>
        </div>
        <div class="bg-gray-900 border border-gray-800 rounded-xl p-6">
          <h3 class="font-semibold text-white mb-2">Nobody knows why</h3>
          <p class="text-gray-400 text-sm leading-relaxed mb-4">
            <code class="text-indigo-300">git blame</code> says who changed a line, not why the agent did it
            that way. The chat was the design meeting, and it is gone.
          </p>
          <p class="text-gray-300 text-sm leading-relaxed">
            HiveMind records the decision with its rationale, its evidence and who made it: you or the agent.
          </p>
        </div>
        <div class="bg-gray-900 border border-gray-800 rounded-xl p-6">
          <h3 class="font-semibold text-white mb-2">It forgot what you agreed</h3>
          <p class="text-gray-400 text-sm leading-relaxed mb-4">
            The hand-kept <code class="text-indigo-300">DECISIONS.md</code> goes stale after a reversal, and the
            agent follows the dead entry.
          </p>
          <p class="text-gray-300 text-sm leading-relaxed">
            In HiveMind a replaced decision reads <code class="text-indigo-300">superseded</code> and a disputed one
            <code class="text-indigo-300">contested</code>. Nobody has to remember to update it.
          </p>
        </div>
      </div>
    </section>

    <!-- The shelf: memory, but for decisions -->
    <section class="border-t border-gray-800 bg-gray-900/30">
      <div class="max-w-4xl mx-auto px-4 sm:px-6 py-16 sm:py-20">
        <h2 class="text-3xl font-bold text-white text-center mb-4">Memory, but for decisions</h2>
        <p class="text-gray-400 text-center max-w-xl mx-auto mb-12">
          When an agent forgets, you look for the fix under memory. HiveMind is that, plus two things memory tools do not keep.
        </p>
        <div class="grid sm:grid-cols-2 gap-6">
          <div class="bg-indigo-950/50 border border-indigo-900 rounded-xl p-6">
            <h3 class="text-lg font-semibold text-white mb-2">The why</h3>
            <p class="text-gray-400 text-sm leading-relaxed">
              The options, the evidence, and who decided, a person or an agent.
            </p>
          </div>
          <div class="bg-emerald-950/40 border border-emerald-900 rounded-xl p-6">
            <h3 class="text-lg font-semibold text-white mb-2">Whether it held up</h3>
            <p class="text-gray-400 text-sm leading-relaxed">
              A status that follows from later contest and supersession, not a label somebody has to
              remember to update. Old decisions are never edited or deleted; the history stays.
            </p>
          </div>
        </div>
        <p class="text-sm text-gray-500 text-center mt-10 max-w-xl mx-auto">
          HiveMind is early: self-hosted only, with no hosted version and no sign-up.
          The code is on <a href="https://github.com/alexknips/hivemind" class="text-indigo-300 hover:text-indigo-200 underline">GitHub</a> under AGPL-3.0.
        </p>
      </div>
    </section>

    <!-- Bottom CTA -->
    <section class="border-t border-gray-800">
      <div class="max-w-6xl mx-auto px-4 sm:px-6 py-20 sm:py-24 text-center">
        <h2 class="text-3xl font-bold text-white mb-4">Start with one decision</h2>
        <p class="text-gray-400 mb-10 max-w-lg mx-auto">
          Install it, connect your agent, and record the next thing you decide together.
        </p>
        <div class="flex flex-col sm:flex-row gap-4 justify-center">
          <a href="#self-host" class="bg-indigo-600 hover:bg-indigo-500 text-white px-8 py-3 rounded-lg font-semibold text-base transition-colors inline-block">
            Self-host it &rarr;
          </a>
          <a href={`${base}demo/`} class="bg-emerald-600 hover:bg-emerald-500 text-white px-8 py-3 rounded-lg font-semibold text-base transition-colors inline-block">
            Explore a real decision &rarr;
          </a>
          <a href={`${base}getting-started/quickstart/`} class="border border-gray-700 hover:border-gray-500 text-gray-300 hover:text-white px-8 py-3 rounded-lg font-semibold text-base transition-colors inline-block">
            Read the docs
          </a>
        </div>
      </div>
    </section>

  </main>

  <!-- Footer -->
  <footer class="border-t border-gray-800 py-12">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 flex flex-col sm:flex-row items-center justify-between gap-4">
      <div class="text-sm text-gray-500">
        HiveMind &mdash; memory for decisions
      </div>
      <div class="flex flex-wrap items-center justify-center gap-x-6 gap-y-2 text-sm text-gray-500">
        <a href={`${base}getting-started/quickstart/`} class="hover:text-gray-300 transition-colors">Docs</a>
        <a href={`${base}use-cases/`} class="hover:text-gray-300 transition-colors">Use cases</a>
        <a href={`${base}pitch/`} class="hover:text-gray-300 transition-colors">Why HiveMind</a>
        <a href="https://github.com/alexknips/hivemind" class="hover:text-gray-300 transition-colors">GitHub</a>
      </div>
    </div>
  </footer>

</body>
</html>
