{
  "decisions": [
    {
      "id": "decision-ac9b4f01-f255-4636-a7b9-edea599e1aab",
      "title": "Store recipes in SQLite on the app server",
      "rationale": "QUESTION: where do recipes live for the first release? OPTIONS: A, SQLite on the app server: nothing to run besides the app, and backups are a file copy. B, Postgres from day one: room to grow, but a second service to run and pay for before anyone uses the app. WHY A: the waiting list is small and one server is plenty for the first year. ACCEPTED COST: a move to a real database later, if the app takes off.",
      "topic_keys": [
        "storage",
        "database"
      ],
      "occurred_at": "2026-03-02T10:05:00Z",
      "project": "recipe-box",
      "source": "human",
      "status": "superseded",
      "deciders": [
        {
          "id": "human:maya.lindqvist@example.com",
          "kind": "human"
        }
      ]
    },
    {
      "id": "decision-916594ab-63b9-49c7-a101-02cd3f5e333a",
      "title": "Sign in with an emailed link instead of a password",
      "rationale": "QUESTION: how do people sign in? OPTIONS: A, a one-time link sent by email. B, a password with a reset flow. WHY A: password resets are the largest share of support mail, and a link removes them. WHAT CHANGES: the sign-in page asks only for an email address. ACCEPTED COST: signing in needs access to the inbox.",
      "topic_keys": [
        "sign-in",
        "support"
      ],
      "occurred_at": "2026-04-10T13:20:00Z",
      "project": "recipe-box",
      "source": "human",
      "status": "accepted",
      "deciders": [
        {
          "id": "human:sam.okafor@example.com",
          "kind": "human"
        }
      ]
    },
    {
      "id": "decision-28f61656-1136-4ff9-ab71-b2801c2dad7b",
      "title": "Move recipe storage from SQLite to Postgres",
      "rationale": "QUESTION: the app now has 4,100 users and SQLite locks up at the evening peak; what now? OPTIONS: A, move to a managed Postgres. B, keep SQLite and queue the writes. WHY A: the lock timeouts come from concurrent writes, which a queue only delays, and a managed database costs less than the time spent on it. WHAT CHANGES: recipes move to Postgres in one weekend migration; SQLite stays read-only for a month as a fallback. ACCEPTED COST: a monthly database bill.",
      "topic_keys": [
        "storage",
        "database",
        "migration"
      ],
      "occurred_at": "2026-06-18T09:30:00Z",
      "project": "recipe-box",
      "source": "human",
      "status": "accepted",
      "deciders": [
        {
          "id": "human:maya.lindqvist@example.com",
          "kind": "human"
        },
        {
          "id": "human:sam.okafor@example.com",
          "kind": "human"
        }
      ]
    },
    {
      "id": "decision-1138b54c-449b-4c20-a55c-740dd6062541",
      "title": "Resize recipe photos once on upload, not on every view",
      "rationale": "Recipe pages are slow on phones, and most of the time goes into resizing the photo each time the page is opened. OPTIONS: A, resize once when the photo is uploaded and keep three sizes. B, resize on view and cache the result. WHY A: the sizes are known, so the work can happen once. Proposed by the app agent; nobody has decided it yet.",
      "topic_keys": [
        "photos",
        "performance"
      ],
      "occurred_at": "2026-07-01T09:15:00Z",
      "project": "recipe-box",
      "source": "agent",
      "status": "proposed",
      "deciders": []
    },
    {
      "id": "decision-a3be77fb-6885-457c-a95c-f6de79b31d4a",
      "title": "Cache products on the phone by product id",
      "rationale": "QUESTION: how does the mobile app keep the product list fast on a slow connection? OPTIONS: A, cache each product on the phone under its product id. B, cache whole API responses by URL. C, no cache. WHY A: a product's id is the one thing that never changes, so the cache never has to be checked. ACCEPTED COST: none expected, as long as ids stay fixed.",
      "topic_keys": [
        "mobile",
        "cache",
        "products"
      ],
      "occurred_at": "2026-04-20T10:00:00Z",
      "project": "orders-mobile",
      "source": "human",
      "status": "accepted",
      "deciders": [
        {
          "id": "human:sam.okafor@example.com",
          "kind": "human"
        }
      ]
    },
    {
      "id": "decision-be667dc0-1b36-4791-a0c3-fb46de424399",
      "title": "Retry failed payment webhooks 5 times, waiting 1 to 16 seconds between tries",
      "rationale": "QUESTION: how many times should the API retry a payment webhook that fails? OPTIONS: A, 3 tries, 2 seconds apart. B, 5 tries, doubling the wait from 1 to 16 seconds. C, retry until it works, with a dead-letter queue. WHY B: provider outages almost always end within 30 seconds, and 5 doubling waits cover 31 seconds. The payments agent chose this within the limits Priya set for it.",
      "topic_keys": [
        "payments",
        "webhooks",
        "retries"
      ],
      "occurred_at": "2026-05-12T08:45:00Z",
      "project": "orders-api",
      "source": "agent",
      "status": "accepted",
      "deciders": [
        {
          "id": "agent:claude:payments-agent",
          "kind": "agent"
        }
      ]
    },
    {
      "id": "decision-3ff4bdcd-e25b-4655-a9dc-e26f609cd57c",
      "title": "Give products new ids when two catalogues merge",
      "rationale": "QUESTION: the spring and autumn catalogues overlap; how do products get ids after the merge? OPTIONS: A, give the merged products new ids. B, keep both id ranges and add a prefix to one. WHY A: one id range keeps every report and export simple. WHAT CHANGES: 1,240 products get new ids on 20 August. ACCEPTED COST: anything that stored an old id has to look it up again.",
      "topic_keys": [
        "products",
        "catalogue",
        "ids"
      ],
      "occurred_at": "2026-08-20T15:00:00Z",
      "project": "orders-api",
