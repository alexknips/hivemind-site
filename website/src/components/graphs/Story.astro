---
// A story in two or three steps (before, what happened, after), each a small
// graph with a line under it. Side by side from lg, stacked below that, each
// frame capped so its words stay the size of the page's small text.
import Frame from './Frame.astro';
import type { Story } from '../../data/graph-stories';

interface Props {
  story: Story;
}

const { story } = Astro.props;
const base = import.meta.env.BASE_URL;
---
<figure class="mt-6 pt-6 border-t border-border min-w-0" aria-labelledby={`${story.id}-title`}>
  <figcaption id={`${story.id}-title`} class="text-xs font-mono uppercase tracking-wide text-muted-foreground mb-4">
    {story.title}
  </figcaption>
  <ol class="grid gap-7 lg:grid-cols-3 lg:gap-5">
    {story.steps.map((step, i) => (
      <li class="min-w-0 max-w-[26rem] lg:max-w-none">
        <p class="text-xs font-mono text-muted-foreground mb-2">
          {i + 1} &middot; {step.label}
        </p>
        <Frame frame={step.frame} alt={step.alt} />
        <p class="text-sm text-muted-foreground leading-relaxed mt-3">{step.caption}</p>
      </li>
    ))}
  </ol>
  <slot />
  {story.demo && (
    <p class="text-sm text-muted-foreground leading-relaxed mt-5">
      <a href={`${base}${story.demo.href}`} class="link">Open it in the demo &rarr;</a>
      <span class="ml-1">{story.demo.text}</span>
    </p>
  )}
</figure>
