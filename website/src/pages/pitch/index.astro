---
// Loomtracer B4SF deck, adapted from Alex Knips's original pitch in this repository.
// Presentation sizing/spacing is scoped design judgment, approved 2026-10-06.
import '@fontsource-variable/fraunces';
import '@fontsource-variable/source-sans-3';
const base = `${import.meta.env.BASE_URL}pitch/`;
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="color-scheme" content="light" />
  <title>Loomtracer — B4SF One-Minute Pitch</title>
  <meta name="description" content="Threaded memory for you, your team, and your AI agents." />
  <style is:global>
    :root {
      --ink:#332B32; --ivory:#FDF8F4; --blue:#1D90CD; --orange:#E25432; --yellow:#F3BA1E;
      --headline:'Fraunces Variable',serif; --body:'Source Sans 3 Variable',sans-serif;
      color-scheme:light; font-family:var(--body); color:var(--ink); background:var(--ink);
    }
    *{box-sizing:border-box}
    html,body{margin:0;min-height:100%;height:100%}
    body{display:grid;place-items:center;-webkit-font-smoothing:antialiased}
    button,a{-webkit-tap-highlight-color:transparent}
    button{font:inherit;cursor:pointer;color:inherit}
    a{color:inherit}
    button:focus-visible,a:focus-visible{outline:3px solid var(--blue);outline-offset:4px}
    h1,h2,h3,p{margin:0}
    h1,h2{font-family:var(--headline);font-weight:600;line-height:1.09;letter-spacing:-.035em}
    .stage{position:relative;width:min(100vw,calc(100svh * 16 / 9));aspect-ratio:16/9;background:var(--ivory);container-type:inline-size;overflow:hidden}
    .deck{height:100%;display:flex;overflow-x:auto;overflow-y:hidden;scroll-snap-type:x mandatory;scrollbar-width:none;outline:none}
    .deck::-webkit-scrollbar{display:none}
    .deck:focus-visible{outline:3px solid var(--blue);outline-offset:-3px}
    .slide{position:relative;flex:0 0 100%;height:100%;padding:5.5cqw 6.25cqw 6.5cqw;scroll-snap-align:start;scroll-snap-stop:always}
    .eyebrow{font-size:1.18cqw;font-weight:600;line-height:1.25;letter-spacing:.1em;text-transform:uppercase}
    .eyebrow::before{content:'';display:inline-block;width:2.1cqw;height:.24cqw;background:var(--orange);margin-right:.9cqw;vertical-align:middle}
    .cover{display:flex;flex-direction:column}
    .cover-grid{display:flex;flex:1;flex-direction:column;justify-content:center;align-items:center;gap:2.8cqw;text-align:center;padding-bottom:1.3cqw}
    .logo{display:block;width:100%;height:auto;aspect-ratio:214/169}
    .cover-logo{width:26cqw}
    .cover h1{font-family:var(--body);font-size:2.3cqw;font-weight:600;line-height:1.3;letter-spacing:0;white-space:nowrap}
    .cover-bottom{display:flex;justify-content:space-between;align-items:baseline;border-top:1px solid var(--ink);padding-top:1.6cqw;gap:3cqw}
    .tagline{font-family:var(--headline);font-size:2.4cqw;font-weight:600;letter-spacing:-.025em}
    .across{font-size:1.8cqw;line-height:1.3}
    .concept .eyebrow{margin-bottom:1.1cqw}
    .concept h2{font-size:3.55cqw;letter-spacing:-.03em}
    .workspace{margin-top:2.15cqw;border:1px solid var(--ink);padding:1.4cqw 2cqw 1.75cqw}
    .workspace-label{font-size:1.15cqw;font-weight:600;letter-spacing:.075em;text-transform:uppercase;display:flex;justify-content:space-between;gap:1cqw}
    .findings{display:grid;grid-template-columns:1fr 1fr;gap:3cqw;margin-top:1.5cqw}
    .finding{border-top:.26cqw solid var(--blue);padding-top:.8cqw}
    .finding:nth-child(2){border-top-color:var(--orange)}
    .finding h3{font-size:1.6cqw;line-height:1.2;font-weight:600;margin-bottom:.65cqw}
    .finding p{font-size:2.25cqw;line-height:1.14}
    .connector{display:block;width:100%;height:3.3cqw;margin:.55cqw 0 .35cqw;overflow:visible}
    .proposal{display:grid;grid-template-columns:18cqw 1fr;gap:1.5cqw;align-items:center;padding:1.2cqw 1.5cqw;background:var(--ink);color:var(--ivory);border-left:.4cqw solid var(--yellow)}
    .proposal h3{font-size:1.6cqw;line-height:1.2;font-weight:600}
    .proposal h3 span{display:block;font-size:1.15cqw;font-weight:400;margin-top:.3cqw}
    .proposal p{font-size:2.25cqw;line-height:1.2}
    .approval{font-size:2.05cqw;line-height:1.2;font-weight:600;margin-top:1.5cqw;text-align:right}
    .approval::before{content:'';display:inline-block;width:.75cqw;height:.75cqw;border-radius:50%;background:var(--yellow);margin-right:.7cqw}
    .problem{display:flex;flex-direction:column}
    .problem-body{display:flex;flex:1;flex-direction:column;justify-content:center}
    .problem h2{font-size:4.65cqw;max-width:19ch}
    .pain-points{display:grid;grid-template-columns:1fr 1fr 1fr;gap:3cqw;margin-top:4.2cqw}
    .pain{border-top:.3cqw solid var(--blue);padding-top:1.3cqw}
    .pain:nth-child(2){border-color:var(--orange)}.pain:nth-child(3){border-color:var(--yellow)}
    .pain h3{font-size:2.35cqw;font-weight:600;line-height:1.2}
    .handoff{font-size:2.15cqw;margin-top:3.2cqw;line-height:1.3}
    .architecture h2,.screenshots h2{font-size:3.8cqw;margin-top:1.5cqw}
    .architecture{display:flex;flex-direction:column}
    .architecture h2{font-size:3.45cqw}
    .decision-flow{flex:none;margin:auto 0;overflow:visible}
    .decision-flow:focus-visible{outline:3px solid var(--blue);outline-offset:4px}
    .decision-flow svg{display:block;width:100%;height:auto;overflow:visible;font-family:var(--body);fill:var(--ink)}
    .flow-stages{font-size:23px;font-weight:600}.flow-step{font-size:16px}
    .flow-rule{fill:none;stroke:var(--ink);stroke-width:1;opacity:.2}
    .flow-links{fill:none;stroke:var(--ink);stroke-width:2;stroke-linecap:round}
    .flow-option rect,.flow-finding rect{fill:var(--ivory);stroke:var(--ink);stroke-width:1}
    .flow-decision rect{fill:var(--ink)}
    .flow-accent{fill:none;stroke-width:4;stroke-linecap:round}.red{stroke:var(--orange)}.blue{stroke:var(--blue)}.yellow{stroke:var(--yellow)}
    .red-fill{fill:var(--orange)}.blue-fill{fill:var(--blue)}.yellow-fill{fill:var(--yellow)}
    .flow-agent{font-size:22px;font-weight:600}.flow-node-title{font-size:29px;font-weight:600}.flow-outcome{font-size:24px}
    .flow-decision-title{font-family:var(--headline);font-size:32px;font-weight:600;fill:var(--ivory)}
    .flow-decision-note{font-size:20px;fill:var(--ivory)}
    .flow-scroll-hint{display:none}
    .flow-review{font-size:24px;font-weight:600;text-anchor:start}
    .architecture-flow{display:grid;grid-template-columns:24cqw 13cqw 1fr;align-items:center;margin-top:4cqw}
    .agent-label{font-family:var(--headline);font-size:2.6cqw;font-weight:600;line-height:1.15}
    .agent-actions{font-size:1.85cqw;line-height:1.45;margin-top:1.3cqw}
    .mcp{display:flex;flex-direction:column;align-items:center;gap:1.3cqw;font-size:1.8cqw;font-weight:600;padding:0 1.8cqw}
    .mcp svg{display:block;width:100%;height:1.7cqw;overflow:visible}
    .memory{background:var(--ink);color:var(--ivory);border-top:.45cqw solid var(--yellow);padding:2.1cqw 2.2cqw}
    .memory h3{font-family:var(--headline);font-size:2.45cqw;font-weight:600;line-height:1.12}
    .memory p{font-size:1.85cqw;line-height:1.35;margin-top:1.4cqw}
    .memory p+p{border-top:1px solid var(--ivory);padding-top:1.05cqw;margin-top:1.05cqw}

    .screen-grid{display:grid;grid-template-columns:1fr 1fr;gap:2cqw;margin-top:2.5cqw}
    .screen-grid figure{margin:0;min-width:0}
    .screen-title{font-size:1.85cqw;font-weight:600;line-height:1.2;margin-bottom:.65cqw}
    .screen-frame{height:28cqw;border:1px solid var(--ink);border-radius:.5cqw;background:var(--ivory);display:flex;align-items:center;overflow:hidden}
    .screen-frame img{display:block;width:100%;height:100%;object-fit:contain}
    .screen-frame.claude{background:var(--ink)}
    .screenshots h2 .availability{font-family:var(--body);font-size:2.3cqw;letter-spacing:0;white-space:nowrap}
    .screen-caption{font-size:1.05cqw;line-height:1.35;margin-top:.7cqw}
    .screenshots .screen-note{font-size:1.45cqw;line-height:1.3;margin-top:1.3cqw}
    .closing{display:flex;flex-direction:column}
    .closing-main{display:grid;grid-template-columns:55cqw 1fr;gap:4cqw;align-items:center;flex:1;padding-top:2.5cqw}
    .closing h2{font-size:5.4cqw}
    .closing-brand{display:flex;flex-direction:column;align-items:center;text-align:center}
    .closing .trial-question{font-family:var(--headline);font-size:3.1cqw;font-weight:600;line-height:1.2;letter-spacing:-.025em;margin-top:2cqw}
    .closing .invite{font-family:var(--headline);font-weight:600;font-size:2.6cqw;line-height:1.2;color:var(--orange);margin-top:1.25cqw;letter-spacing:-.025em}
    .closing .question{font-size:1.95cqw;line-height:1.3;margin-top:1cqw}
    .closing-qr-link{display:block;margin-top:.6cqw}
    .closing-qr{display:block;width:10.5cqw;height:10.5cqw}
    .closing-bottom{margin-top:auto}
    .founders{display:flex;gap:4.6cqw;padding-top:1.4cqw;border-top:1px solid var(--ink);width:55cqw}
    .founder-name{font-size:1.75cqw;line-height:1.2;font-weight:600}
    .founder-role{font-size:1.45cqw;line-height:1.35;margin-top:.3cqw}
    .closing-logo{width:25cqw}
    .controls{position:absolute;bottom:1.4cqw;left:6.25cqw;right:6.25cqw;display:flex;align-items:center;justify-content:space-between;font-size:1cqw;line-height:1.2;gap:1.5cqw}
    .count{font-variant-numeric:tabular-nums;min-width:5cqw}
    .count strong{font-weight:600}
    .dots{position:absolute;left:50%;transform:translateX(-50%);display:flex;gap:.35cqw}
    .dots button{display:grid;place-items:center;border:0;background:transparent;padding:.6cqw;width:2cqw;height:2cqw}
    .dots button::before{content:'';display:block;border:1px solid var(--ink);border-radius:50%;width:.55cqw;height:.55cqw;background:var(--ivory)}
    .dots button[aria-current="true"]::before{background:var(--ink)}
    .actions{display:flex;align-items:center;gap:.7cqw}
    .notes-link{text-decoration:none;margin-right:1cqw;font-weight:600}
    .notes-link:hover{text-decoration:underline;text-underline-offset:.2em}
    .arrow,.fullscreen{display:grid;place-items:center;width:2.5cqw;height:2.2cqw;border:1px solid var(--ink);background:transparent;font-size:1.2cqw;line-height:1}
    .arrow:hover,.fullscreen:hover{background:var(--yellow)}
    button:disabled{opacity:.3;cursor:default}
    .sr-only{position:absolute;width:1px;height:1px;margin:-1px;overflow:hidden;clip:rect(0,0,0,0);white-space:nowrap}
    .stage:fullscreen{width:100%;height:100%;aspect-ratio:auto;display:grid;place-items:center;background:var(--ink)}
    .stage:fullscreen .deck{width:min(100vw,calc(100vh * 16 / 9));aspect-ratio:16/9;height:auto;background:var(--ivory)}
    @media(max-width:760px){
      html,body{height:auto;min-height:100%;display:block;background:var(--ivory)}
      .stage{width:100%;aspect-ratio:auto;overflow:visible;container-type:normal}
      .deck{display:block;height:auto;overflow:visible}
      .slide{height:auto;padding:36px 24px 40px;border-bottom:1px solid var(--ink)}
      .eyebrow{font-size:12px;letter-spacing:.06em;line-height:1.4}
      .eyebrow::before{width:22px;height:3px;margin-right:8px}
      .cover-grid{gap:34px;margin:42px 0 12px;padding:0}
      .cover-logo{width:224px}
      .cover h1{font-size:26px;max-width:28ch;white-space:normal}
      .cover-bottom{display:block;padding-top:22px}
      .tagline{font-size:28px}
      .across{font-size:20px;margin-top:12px}
      .concept .eyebrow{margin-bottom:20px}
      .concept h2{font-size:38px;line-height:1.1}
      .workspace{margin-top:30px;padding:20px 18px 22px}
      .workspace-label{font-size:11px;line-height:1.4;display:block}
      .workspace-label span{display:block;margin-top:4px}
      .findings{grid-template-columns:1fr;gap:22px;margin-top:25px}
      .finding{border-top-width:4px;padding-top:12px}
      .finding h3{font-size:20px;margin-bottom:7px}
      .finding p{font-size:26px;line-height:1.15}
      .connector{height:40px;margin:10px 0}
      .proposal{grid-template-columns:1fr;gap:12px;padding:18px;border-left-width:5px}
      .proposal h3{font-size:20px}
      .proposal h3 span{font-size:16px;margin-top:2px}
      .proposal p{font-size:26px}
      .approval{font-size:23px;text-align:left;margin-top:24px}
      .approval::before{width:9px;height:9px;margin-right:8px}
      .problem,.problem-body{display:block}
      .problem h2{font-size:42px;margin-top:42px}
      .pain-points{grid-template-columns:1fr;gap:24px;margin-top:34px}
      .pain{border-top-width:4px;padding-top:14px}.pain h3{font-size:28px;max-width:none}
      .handoff{font-size:25px;margin-top:30px}
      .architecture{display:block}
      .architecture h2,.screenshots h2{font-size:38px;margin-top:24px}
      .decision-flow{margin:28px 0 0;overflow-x:auto;padding:4px 2px 8px}
      .decision-flow svg{min-width:1000px}
      .flow-scroll-hint{display:block;font-size:15px;margin-top:8px}
      .architecture-flow{grid-template-columns:1fr;margin-top:32px}
      .agent-label{font-size:30px}.agent-actions{font-size:23px;margin-top:14px}
      .mcp{font-size:21px;gap:10px;padding:24px 0;align-items:flex-start}
      .mcp svg{width:78px;height:20px}.memory{border-top-width:6px;padding:25px 22px}
      .memory h3{font-size:29px}.memory p{font-size:23px;margin-top:18px}.memory p+p{padding-top:16px;margin-top:16px}
      .screen-grid{grid-template-columns:1fr;gap:30px;margin-top:30px}
      .screen-title{font-size:25px;margin-bottom:12px}.screen-frame{height:auto;min-height:180px;border-radius:6px}
      .screen-frame img{height:auto}.screenshots h2 .availability{display:block;font-size:25px;margin-top:9px}
      .screen-caption{font-size:15px;margin-top:10px}.screenshots .screen-note{font-size:20px;margin-top:24px}
      .closing-main{grid-template-columns:1fr;gap:42px;padding:0;margin-top:42px}
      .closing h2{font-size:48px}
      .closing .trial-question{font-size:32px;margin-top:28px}
      .closing .invite{font-size:28px;margin-top:22px}
      .closing .question{font-size:23px;margin-top:14px}
      .closing-bottom{display:block;margin-top:40px}
      .founders{display:grid;gap:24px;width:100%;padding-top:24px}
      .founder-name{font-size:23px}.founder-role{font-size:20px;margin-top:5px}
      .closing-logo{width:224px}
      .closing-qr-link{margin-top:14px}
      .closing-qr{width:148px;height:148px}
      .metrics{min-height:260px}
      .controls{position:static;padding:20px 24px;display:flex;font-size:14px}
      .count,.dots,.arrow,.fullscreen{display:none}
      .actions{gap:0}.notes-link{margin:0}
    }
    @media print{
      @page{size:16in 9in;margin:0}
      html,body{display:block;height:auto;background:var(--ivory)}
      .stage{width:16in;aspect-ratio:auto;overflow:visible;container-type:inline-size}
      .deck{display:block;height:auto;overflow:visible}
      .slide{width:16in;height:9in;break-after:page;break-inside:avoid}
      .slide:last-child{break-after:auto}.controls{display:none}
      *{-webkit-print-color-adjust:exact;print-color-adjust:exact}
    }
  </style>
</head>
<body>
  <div class="stage" id="stage">
    <main class="deck" id="deck" tabindex="0" aria-label="Loomtracer one-minute pitch. Use left and right arrow keys to change slides.">
      <section class="slide cover" id="slide-1" aria-label="1. Loomtracer threaded memory">
        <p class="eyebrow">B4SF Pitch Night</p>
        <div class="cover-grid">
          <img class="logo cover-logo" src={`${base}brand/loomtracer-color.svg`} width="214" height="169" alt="Loomtracer" />
          <h1>Threaded memory for you, your team, and your AI agents.</h1>
        </div>
      </section>

      <section class="slide problem" id="slide-2" aria-label="2. The problem">
        <p class="eyebrow">The problem</p>
        <div class="problem-body">
          <h2>Context gets<br />left behind</h2>
          <div class="pain-points">
            <div class="pain"><h3>Findings get buried over time.</h3></div>
            <div class="pain"><h3>Decisions separate from reasoning.</h3></div>
            <div class="pain"><h3>It’s up to you to connect lost threads.</h3></div>
          </div>
        </div>
      </section>

      <section class="slide architecture" id="slide-3" aria-label="3. Trace decisions and reasoning">
        <p class="eyebrow">How it works</p>
        <h2>Trace decisions and reasoning from start to finish</h2>
        <figure class="decision-flow" tabindex="0" aria-label="Decision flow. Scroll horizontally on narrow screens.">
          <svg viewBox="0 0 1400 470" role="img" aria-labelledby="flow-title flow-description">
            <title id="flow-title">Trace a decision through exploration, evidence, and human approval</title>
            <desc id="flow-description">Agent Red, Agent Blue, and Agent Yellow explore three options. Each produces an evidence artifact: didn’t work, mixed results, or promising. The artifacts contribute to a decision ratified by you and your team.</desc>
            <defs><marker id="flow-arrow" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="8" markerHeight="8" orient="auto-start-reverse"><path d="M1 1L9 5L1 9" fill="none" stroke="var(--ink)" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" /></marker></defs>
            <g class="flow-stages">
              <text x="0" y="28"><tspan class="flow-step">01</tspan><tspan dx="15">Divide work</tspan></text>
              <text x="510" y="28"><tspan class="flow-step">02</tspan><tspan dx="15">Evidence</tspan></text>
              <text x="1060" y="28"><tspan class="flow-step">03</tspan><tspan dx="15">Ratify decisions</tspan></text>
            </g>
            <path class="flow-rule" d="M0 54H1400" />
            <g class="flow-links" marker-end="url(#flow-arrow)">
              <path d="M360 142H507" /><path d="M360 264H507" /><path d="M360 386H507" />
              <path d="M870 142C965 142 965 242 1057 242" />
              <path d="M870 264H1057" />
              <path d="M870 386C965 386 965 286 1057 286" />
            </g>
            <g class="flow-option" transform="translate(0 94)">
              <rect rx="8" width="360" height="96" /><path class="flow-accent red" d="M2 8Q2 2 8 2H352Q358 2 358 8" />
              <circle class="red-fill" cx="25" cy="29" r="5" /><text class="flow-agent" x="41" y="36">Agent Red</text>
              <text class="flow-node-title" x="24" y="74">Option 1</text>
            </g>
            <g class="flow-option" transform="translate(0 216)">
              <rect rx="8" width="360" height="96" /><path class="flow-accent blue" d="M2 8Q2 2 8 2H352Q358 2 358 8" />
              <circle class="blue-fill" cx="25" cy="29" r="5" /><text class="flow-agent" x="41" y="36">Agent Blue</text>
              <text class="flow-node-title" x="24" y="74">Option 2</text>
            </g>
            <g class="flow-option" transform="translate(0 338)">
              <rect rx="8" width="360" height="96" /><path class="flow-accent yellow" d="M2 8Q2 2 8 2H352Q358 2 358 8" />
              <circle class="yellow-fill" cx="25" cy="29" r="5" /><text class="flow-agent" x="41" y="36">Agent Yellow</text>
              <text class="flow-node-title" x="24" y="74">Option 3</text>
            </g>
            <g class="flow-finding" transform="translate(510 94)">
              <rect rx="8" width="360" height="96" /><text class="flow-node-title" x="24" y="40">Artifact 1</text><text class="flow-outcome" x="24" y="73">Didn’t work</text>
            </g>
            <g class="flow-finding" transform="translate(510 216)">
              <rect rx="8" width="360" height="96" /><text class="flow-node-title" x="24" y="40">Artifact 2</text><text class="flow-outcome" x="24" y="73">Mixed results</text>
            </g>
            <g class="flow-finding" transform="translate(510 338)">
              <rect rx="8" width="360" height="96" /><text class="flow-node-title" x="24" y="40">Artifact 3</text><text class="flow-outcome" x="24" y="73">Promising</text>
            </g>
            <g class="flow-decision">
              <rect rx="8" x="1060" y="202" width="340" height="124" />
              <circle class="red-fill" cx="1089" cy="225" r="5" /><circle class="blue-fill" cx="1107" cy="225" r="5" /><circle class="yellow-fill" cx="1125" cy="225" r="5" />
              <text class="flow-decision-title" x="1084" y="266">Decision</text>
              <text class="flow-decision-note" x="1084" y="300">Ratified</text>
            </g>
            <circle class="yellow-fill flow-review-bullet" cx="1068" cy="373" r="5" />
            <text class="flow-review" x="1084" y="381"><tspan x="1084">You and your team</tspan><tspan x="1084" dy="29">approve the direction.</tspan></text>
          </svg>
        </figure>
        <p class="flow-scroll-hint">Scroll to follow the full flow →</p>
      </section>

      <section class="slide metrics" id="slide-4" aria-label="4. Decision Metrics">
        <p class="eyebrow">Decision Metrics</p>
      </section>

      <section class="slide closing" id="slide-5" aria-label="5. Thank You">
        <p class="eyebrow">Outro</p>
        <div class="closing-main">
          <div class="closing-message">
            <h2>Thank You</h2>
            <p class="trial-question">Do you want to try it for yourself?</p>
            <p class="invite">We want to talk to you.</p>
          </div>
          <div class="closing-brand">
            <img class="logo closing-logo" src={`${base}brand/loomtracer-color.svg`} width="214" height="169" alt="Loomtracer" />
            <p class="question" title="Placeholder URL — not yet a live destination">www.loomtracer.ai</p>
            <a class="closing-qr-link" href="https://www.loomtracer.ai" target="_blank" rel="noopener noreferrer" aria-label="Open www.loomtracer.ai" title="QR destination: https://www.loomtracer.ai (placeholder URL)"><img class="closing-qr" src={`${base}brand/loomtracer-qr.svg`} width="370" height="370" alt="QR code for https://www.loomtracer.ai" /></a>
          </div>
        </div>
        <div class="closing-bottom">
          <div class="founders">
            <div><p class="founder-name">Jeff Miao</p><p class="founder-role">Co-founder · Design</p></div>
            <div><p class="founder-name">Alex Knips</p><p class="founder-role">Co-founder · Technology</p></div>
          </div>
        </div>
      </section>
    </main>
    <nav class="controls" aria-label="Presentation controls">
      <span class="count" aria-live="polite"><strong id="current">01</strong> / 05</span>
      <div class="dots" aria-label="Choose a slide">
        <button data-slide="0" aria-label="Go to slide 1" aria-current="true"></button>
        <button data-slide="1" aria-label="Go to slide 2" aria-current="false"></button>
        <button data-slide="2" aria-label="Go to slide 3" aria-current="false"></button>
        <button data-slide="3" aria-label="Go to slide 4" aria-current="false"></button>
        <button data-slide="4" aria-label="Go to slide 5" aria-current="false"></button>
      </div>
      <div class="actions">
        <a class="notes-link" href={`${base}presenter/`} target="loomtracer-presenter">Presenter notes</a>
        <button class="fullscreen" id="fullscreen" aria-label="Enter full screen" title="Full screen (F)">⛶</button>
        <button class="arrow" id="previous" aria-label="Previous slide" disabled>←</button>
        <button class="arrow" id="next" aria-label="Next slide">→</button>
      </div>
    </nav>
  </div>
  <script>
    const deck=document.querySelector<HTMLElement>('#deck')!;
    const slides=Array.from(deck.querySelectorAll<HTMLElement>('.slide'));
    const dots=Array.from(document.querySelectorAll<HTMLButtonElement>('[data-slide]'));
    const previous=document.querySelector<HTMLButtonElement>('#previous')!;
    const next=document.querySelector<HTMLButtonElement>('#next')!;
    const stacked=matchMedia('(max-width:760px)');
    const channel=typeof BroadcastChannel!=='undefined'?new BroadcastChannel('loomtracer-pitch'):null;
    const hashIndex=Number(location.hash.match(/^#slide-([1-5])$/)?.[1]||1)-1;
    let current=hashIndex;
    function paint(){
      document.querySelector('#current')!.textContent=String(current+1).padStart(2,'0');
      dots.forEach((dot,n)=>dot.setAttribute('aria-current',String(n===current)));
      slides.forEach((slide,n)=>{
        slide.inert=!stacked.matches&&n!==current;
        slide.setAttribute('aria-hidden',String(!stacked.matches&&n!==current));
      });
      previous.disabled=current===0;next.disabled=current===slides.length-1;
      history.replaceState(null,'',`#slide-${current+1}`);
      channel?.postMessage({type:'slide',index:current});
    }
    function go(index:number){
      current=Math.min(slides.length-1,Math.max(0,index));
      if(stacked.matches)slides[current].scrollIntoView({behavior:'instant',block:'start'});
      else deck.scrollTo({left:current*deck.clientWidth,behavior:'instant'});
      paint();
    }
    dots.forEach((dot,n)=>dot.addEventListener('click',()=>go(n)));
    previous.addEventListener('click',()=>go(current-1));next.addEventListener('click',()=>go(current+1));
    const fullscreen=document.querySelector<HTMLButtonElement>('#fullscreen')!;
    async function toggleFullscreen(){
      try{if(document.fullscreenElement)await document.exitFullscreen();else await document.documentElement.requestFullscreen();}
      catch{fullscreen.setAttribute('title','Use your browser’s full-screen command');}
    }
    fullscreen.addEventListener('click',toggleFullscreen);
    document.addEventListener('fullscreenchange',()=>fullscreen.setAttribute('aria-label',document.fullscreenElement?'Exit full screen':'Enter full screen'));
    window.addEventListener('keydown',event=>{
      if(event.altKey||event.ctrlKey||event.metaKey||event.target instanceof HTMLInputElement||event.target instanceof HTMLTextAreaElement)return;
      if(event.key.toLowerCase()==='f'){event.preventDefault();void toggleFullscreen();return;}
      if(stacked.matches)return;
      if(event.key==='ArrowRight'||event.key==='PageDown'){event.preventDefault();go(current+1);}
      else if(event.key==='ArrowLeft'||event.key==='PageUp'){event.preventDefault();go(current-1);}
      else if(event.key==='Home'){event.preventDefault();go(0);}
      else if(event.key==='End'){event.preventDefault();go(slides.length-1);}
      else if(event.key===' '&&!(event.target instanceof HTMLButtonElement)&&!(event.target instanceof HTMLAnchorElement)){event.preventDefault();go(current+1);}
    });
    let scrolling:ReturnType<typeof setTimeout>;
    deck.addEventListener('scroll',()=>{
      if(stacked.matches)return;
      clearTimeout(scrolling);scrolling=setTimeout(()=>{
        const index=Math.round(deck.scrollLeft/deck.clientWidth);
        if(index!==current){current=index;paint();}
      },70);
    },{passive:true});
    let mobileFrame=0;
    function syncStackedIndex(){
      if(!stacked.matches)return;
      const marker=innerHeight*.35;
      const visible=slides.findIndex(slide=>slide.getBoundingClientRect().bottom>marker);
      const index=visible<0?slides.length-1:visible;
      if(index!==current){current=index;paint();}
    }
    window.addEventListener('scroll',()=>{
      if(!stacked.matches||mobileFrame)return;
      mobileFrame=requestAnimationFrame(()=>{mobileFrame=0;syncStackedIndex();});
    },{passive:true});
    stacked.addEventListener('change',syncStackedIndex);
    new ResizeObserver(()=>{if(!stacked.matches)deck.scrollTo({left:current*deck.clientWidth,behavior:'instant'});paint();}).observe(deck);
    channel?.addEventListener('message',event=>{
      if(event.data?.type==='navigate'&&Number.isInteger(event.data.index))go(event.data.index);
      if(event.data?.type==='request-state')channel.postMessage({type:'slide',index:current});
    });
    window.addEventListener('hashchange',()=>{const n=Number(location.hash.match(/^#slide-([1-5])$/)?.[1]||1)-1;go(n);});
    if(!stacked.matches)go(current);else paint();
  </script>
</body>
</html>
