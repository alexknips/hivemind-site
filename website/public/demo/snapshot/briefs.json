  "decision-28f61656-1136-4ff9-ab71-b2801c2dad7b": {
    "data": {
      "decision_id": "decision-28f61656-1136-4ff9-ab71-b2801c2dad7b",
      "title": "Move recipe storage from SQLite to Postgres",
      "rationale": "QUESTION: the app now has 4,100 users and SQLite locks up at the evening peak; what now? OPTIONS: A, move to a managed Postgres. B, keep SQLite and queue the writes. WHY A: the lock timeouts come from concurrent writes, which a queue only delays, and a managed database costs less than the time spent on it. WHAT CHANGES: recipes move to Postgres in one weekend migration; SQLite stays read-only for a month as a fallback. ACCEPTED COST: a monthly database bill.",
      "status": "accepted",
      "occurred_at": "2026-06-18T09:30:00Z",
      "project": "recipe-box",
      "project_label": "Recipe Box app",
      "topic_keys": [
        "storage",
        "database",
        "migration"
      ],
      "chosen_option": {
        "label": "managed postgres",
        "option_id": "option-managed-postgres-663dd46d-1160-4bf4-a79a-c207ffe7d4ea"
      },
      "rejected_options": [
        {
          "label": "keep sqlite and queue writes",
          "option_id": "option-keep-sqlite-and-queue-writes-0b0ab6f8-6c06-4010-a9d6-18c266e98238"
        }
      ],
      "decided_by": {
        "proposer_id": "human:maya.lindqvist@example.com",
        "decider_ids": [
          "human:maya.lindqvist@example.com",
          "human:sam.okafor@example.com"
        ],
        "review": "peer_reviewed",
        "source": "human"
      },
      "rests_on": [
        {
          "kind": "evidence",
          "id": "evidence-1946294a-6544-4acd-aec9-40cfe02ae652",
          "label": "Write-lock timeouts on 3 of the last 7 days, all at the evening peak, with 4,100 users.",
